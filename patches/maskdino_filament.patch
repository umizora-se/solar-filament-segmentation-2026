+def focal_tversky_loss(
+        inputs: torch.Tensor,
+        targets: torch.Tensor,
+        num_masks: float,
+        alpha: float = 0.7,
+        beta: float = 0.3,
+        gamma: float = 1.0,
+    ):
+    """PATCHED (filament baseline): Tversky 損失（FN偏重）。
+
+    Tversky = TP / (TP + alpha*FN + beta*FP)。alpha>beta で FN（見逃し）を重く罰する。
+    本データは FN(630) > FP(556) で見逃しが多く、細く淡いフィラメントを拾いにいくため
+    alpha=0.7, beta=0.3。Dice と同じ点サンプリング済みの平坦ベクトル上で計算する。
+
+    注: gamma<1 の focal 項は loss=0 付近で勾配が発散し AMP で NaN を生むため、
+    既定は gamma=1.0（通常の Tversky）。focal 効果が欲しければ gamma>=1 を使う。
+    """
+    inputs = inputs.sigmoid().flatten(1)
+    targets = targets.flatten(1)
+    tp = (inputs * targets).sum(-1)
+    fn = (targets * (1 - inputs)).sum(-1)
+    fp = ((1 - targets) * inputs).sum(-1)
+    tversky = (tp + 1) / (tp + alpha * fn + beta * fp + 1)
+    base = (1 - tversky).clamp(min=1e-6)      # 0近傍を避けて勾配発散を防ぐ
+    loss = base if gamma == 1.0 else base ** gamma
+    return loss.sum() / num_masks
+
+
+focal_tversky_loss_jit = torch.jit.script(focal_tversky_loss)
