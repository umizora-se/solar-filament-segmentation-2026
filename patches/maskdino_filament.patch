+    def _matched_mask_iou(self, outputs, targets, indices, n_pts: int = 1024):
+        """PATCHED (filament IoU-aware cls): 一致した (予測, GT) ごとのマスク IoU を点サンプリングで推定する。
+
+        予測の箱と GT の箱を合わせた矩形に一様に点を打つ。両マスクをほぼ含む領域で一様に打てば
+        |交差| / |和| の比は面積に依らず偏りなく推定できる（全面に打つと細いフィラメントに点が当たらない）。
+        予測マスクは logit > 0（= sigmoid > 0.5、推論の 2 値化と同じ）。返り値の並びは
+        _get_src_permutation_idx と同じ（バッチ順に連結）。
+        """
+        pm = outputs.get("pred_masks")
+        pboxes = outputs.get("pred_boxes")
+        if pm is None or pboxes is None:
+            return None
+        out = []
+        for b, (src, tgt) in enumerate(indices):
+            if len(src) == 0:
+                continue
+            t = targets[b]
+            sc = t.get("pad_scale")
+            if sc is None:
+                return None
+            pb = box_ops.box_cxcywh_to_xyxy(pboxes[b, src].float())
+            gb = box_ops.box_cxcywh_to_xyxy(t["boxes"][tgt].float())
+            lo = torch.minimum(pb[:, :2], gb[:, :2]).clamp(0, 1)
+            hi = torch.maximum(pb[:, 2:], gb[:, 2:]).clamp(0, 1)
+            hi = torch.maximum(hi, lo + 1e-3)
+            n = len(src)
+            u = torch.rand(n, n_pts, 2, device=pb.device)
+            pts = (lo[:, None] + u * (hi - lo)[:, None]) * sc.view(1, 1, 2)      # (n, P, 2) パディング込み正規化
+            if pm.dim() == 3:                                                     # 点計算モード: 埋め込み (B,Q,C)
+                feats = point_sample(_pm.mask_features()[b:b + 1].float(), pts.reshape(1, -1, 2),
+                                     align_corners=False)[0]                      # (C, n*P)
+                feats = feats.view(feats.shape[0], n, n_pts)
+                logit = torch.einsum("nc,cnp->np", pm[b, src].float(), feats)
+            else:                                                                 # 全面マスク (B,Q,h,w)
+                logit = point_sample(pm[b, src][:, None].float(), pts, align_corners=False).squeeze(1)
+            gt = point_sample(t["masks"][tgt][:, None].float(), pts, align_corners=False).squeeze(1) > 0.5
+            pr = logit > 0
+            inter = (pr & gt).sum(1).float()
+            union = (pr | gt).sum(1).float()
+            out.append(torch.where(union > 0, inter / union.clamp(min=1), torch.zeros_like(union)))
+        if not out:
+            return None
+        return torch.cat(out).clamp(0, 1)
